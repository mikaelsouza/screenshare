{
  "$schema": "https://raw.githubusercontent.com/electron-userland/electron-builder/master/packages/app-builder-lib/scheme.json",
  "appId": "com.screenshare.app",
  "productName": "Screenshare",
  "directories": {
    "output": "release"
  },
  "files": [
    "dist/**/*",
    "dist-electron/**/*",
    "package.json",
    "!**/node_modules/zod{,/**}",
    "!**/node_modules/loopback-capture/src{,/**}",
    "!**/node_modules/loopback-capture/scripts{,/**}",
    "!**/node_modules/loopback-capture/CMakeLists.txt"
  ],
  "asar": true,
  "asarUnpack": [
    "**/*.node"
  ],
  "npmRebuild": false,
  "publish": [
    {
      "provider": "github",
      "owner": "mikaelsouza",
      "repo": "screenshare",
      "releaseType": "release"
    }
  ],
  "win": {
    "icon": "assets/icon.ico",
    "target": [
      {
        "target": "nsis",
        "arch": ["x64"]
      }
    ]
  },
  "nsis": {
    "artifactName": "${productName}-Setup-${version}.${ext}",
    "oneClick": false,
    "perMachine": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "shortcutName": "Screenshare",
    "uninstallDisplayName": "Screenshare"
  }
}
