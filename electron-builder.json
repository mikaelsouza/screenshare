{
  "$schema": "https://raw.githubusercontent.com/electron-userland/electron-builder/master/packages/app-builder-lib/scheme.json",
  "appId": "com.screenshare.app",
  "productName": "Screenshare",
  "compression": "maximum",
  "electronLanguages": ["en-US"],
  "directories": {
    "output": "release",
    "buildResources": "assets"
  },
  "files": [
    "dist-electron/**/*",
    "!dist-electron/**/*.d.{ts,cts}",
    "package.json",
    "!**/node_modules/zod{,/**}",
    "!**/node_modules/loopback-capture/src{,/**}",
    "!**/node_modules/loopback-capture/scripts{,/**}",
    "!**/node_modules/loopback-capture/CMakeLists.txt",
    "!**/node_modules/loopback-capture/prebuilds/linux-*{,/**}",
    "!**/node_modules/koffi/doc{,/**}",
    "!**/node_modules/koffi/lib{,/**}",
    "!**/node_modules/koffi/vendor{,/**}",
    "!**/node_modules/koffi/cnoke.cjs",
    "!**/node_modules/koffi/src/koffi/CMakeLists.txt",
    "!**/node_modules/koffi/src/koffi/src/abi{,/**}",
    "!**/node_modules/koffi/src/koffi/src/*.{cc,hh,inc,def}"
  ],
  "asar": true,
  "asarUnpack": [
    "**/*.node"
  ],
  "electronFuses": {
    "runAsNode": false,
    "enableCookieEncryption": true,
    "enableNodeOptionsEnvironmentVariable": false,
    "enableNodeCliInspectArguments": false,
    "enableEmbeddedAsarIntegrityValidation": true,
    "onlyLoadAppFromAsar": true
  },
  "npmRebuild": false,
  "publish": [
    {
      "provider": "github",
      "owner": "mikaelsouza",
      "repo": "screenshare",
      "releaseType": "release"
    }
  ],
  "win": {
    "icon": "assets/icon.ico",
    "target": [
      {
        "target": "nsis",
        "arch": ["x64"]
      }
    ]
  },
  "nsis": {
    "artifactName": "${productName}-Setup-${version}.${ext}",
    "oneClick": false,
    "perMachine": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "shortcutName": "Screenshare",
    "uninstallDisplayName": "Screenshare"
  }
}
