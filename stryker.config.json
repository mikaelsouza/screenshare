{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "packageManager": "npm",
  "testRunner": "vitest",
  "plugins": ["@stryker-mutator/vitest-runner"],
  "tsconfigFile": "",
  "mutate": [
    "electron/config.ts",
    "electron/follow/**/*.ts",
    "electron/audio/**/*.ts",
    "electron/picker.ts",
    "electron/updater.ts",
    "scripts/check-guardrails-diff.ts",
    "shared/protocol.ts",
    "src/capture.ts",
    "src/controllers/**/*.ts",
    "src/host-tokens.ts",
    "src/mesh.ts",
    "src/platform/**/*.ts",
    "!src/platform/types.ts",
    "src/quality.ts",
    "src/signaling.ts",
    "src/stats.ts",
    "src/ui-model.ts",
    "worker/ipkey.ts",
    "worker/ratelimit.ts",
    "worker/room-crypto.ts",
    "worker/room-models.ts",
    "worker/room-policy.ts",
    "worker/upgrade.ts"
  ],
  "ignorePatterns": ["release/**", "dist/**", "dist-electron/**", "reports/**", ".wrangler/**", ".stryker-tmp/**"],
  "vitest": {
    "configFile": "vitest.config.ts"
  },
  "reporters": ["html", "clear-text", "progress"],
  "htmlReporter": {
    "fileName": "reports/mutation/mutation.html"
  },
  "thresholds": {
    "high": 90,
    "low": 80,
    "break": 85
  },
  "ignoreStatic": true,
  "concurrency": 4,
  "timeoutMS": 15000
}
