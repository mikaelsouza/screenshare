{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "packageManager": "npm",
  "testRunner": "vitest",
  "plugins": ["@stryker-mutator/vitest-runner"],
  "tsconfigFile": "",
  "mutate": [
    "shared/**/*.ts",
    "src/**/*.ts",
    "electron/**/*.ts",
    "worker/**/*.ts",
    "scripts/check-guardrails-diff.ts",
    "scripts/run-stryker-ci.ts",
    "scripts/smoke-test-packaged.ts",
    "!**/*.d.ts",
    "!src/main.ts",
    "!src/views/**/*.ts",
    "!src/platform/types.ts",
    "!electron/main.ts",
    "!worker/index.ts",
    "!worker/room.ts",
    "!worker/room-actions.ts",
    "!worker/room-lifecycle.ts",
    "!worker/room-membership.ts"
  ],
  "ignorePatterns": ["release/**", "dist/**", "dist-electron/**", "reports/**", ".wrangler/**", ".stryker-tmp/**"],
  "vitest": {
    "configFile": "vitest.config.ts"
  },
  "reporters": ["html", "clear-text", "progress"],
  "htmlReporter": {
    "fileName": "reports/mutation/mutation.html"
  },
  "thresholds": {
    "high": 90,
    "low": 80,
    "break": 85
  },
  "ignoreStatic": true,
  "concurrency": 4,
  "timeoutMS": 15000
}
