{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "noEmit": true,
    "paths": {
      "@shared/*": ["./shared/*"],
      "@src/*": ["./src/*"],
      "@worker/*": ["./worker/*"]
    }
  },
  "include": ["src/**/*.ts", "shared/**/*.ts", "test/unit/**/*.ts"]
}
