{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": [
    "typescript",
    "unicorn",
    "oxc",
    "import",
    "promise",
    "node",
    "vitest"
  ],
  "categories": {
    "correctness": "error"
  },
  "rules": {
    "eqeqeq": "error",
    "no-debugger": "error",
    "no-self-compare": "error",
    "no-template-curly-in-string": "error",
    "no-unreachable": "error",
    "no-unused-vars": "error",
    "no-constant-condition": "error",
    "max-lines": [
      "error",
      {
        "max": 500,
        "skipBlankLines": true,
        "skipComments": true
      }
    ],
    "complexity": ["error", 15],
    "no-restricted-imports": [
      "error",
      {
        "paths": [
          {
            "name": "zod",
            "message": "Import validated schemas and parsers from shared/protocol.ts instead of importing zod directly."
          }
        ]
      }
    ],
    "node/no-process-env": "error",
    "typescript/ban-ts-comment": "error",
    "typescript/no-explicit-any": "error",
    "typescript/no-non-null-asserted-optional-chain": "error",
    "typescript/no-floating-promises": "error",
    "typescript/no-misused-promises": "error",
    "typescript/no-unsafe-assignment": "error",
    "typescript/no-unsafe-call": "error",
    "typescript/no-unsafe-member-access": "error",
    "typescript/no-unsafe-return": "error",
    "typescript/no-unsafe-argument": "error",
    "typescript/switch-exhaustiveness-check": "error",
    "typescript/await-thenable": "error",
    "typescript/unbound-method": "error",
    "typescript/no-unsafe-function-type": "error",
    "typescript/no-wrapper-object-types": "error",
    "typescript/prefer-as-const": "error",
    "typescript/no-unsafe-type-assertion": "error",
    "typescript/no-unnecessary-type-assertion": "error",
    "typescript/only-throw-error": "error",
    "typescript/prefer-promise-reject-errors": "error",
    "typescript/no-implied-eval": "error",
    "typescript/restrict-plus-operands": "error",
    "typescript/use-unknown-in-catch-callback-variable": "error",
    "vitest/expect-expect": "error",
    "vitest/valid-expect": "error",
    "unicorn/no-useless-spread": "allow",
    "vitest/require-mock-type-parameters": "allow",
    "vitest/no-conditional-expect": "allow"
  },
  "overrides": [
    {
      "files": ["test/**/*.ts"],
      "rules": {
        "max-lines": "allow",
        "complexity": "allow",
        "no-restricted-imports": "allow",
        "node/no-process-env": "allow",
        "typescript/no-unsafe-type-assertion": "allow"
      }
    },
    {
      "files": ["shared/protocol.ts"],
      "rules": {
        "no-restricted-imports": "allow"
      }
    },
    {
      "files": ["electron/config.ts", "scripts/**/*.ts", "*.config.ts"],
      "rules": {
        "node/no-process-env": "allow"
      }
    },
    {
      "files": ["src/main.ts"],
      "rules": {
        "max-lines": "allow",
        "complexity": "allow"
      }
    },
    {
      "files": [
        "src/signaling.ts",
        "shared/protocol.ts",
        "src/ui-model.ts",
        "scripts/smoke-test.ts"
      ],
      "rules": {
        "complexity": "allow"
      }
    },
    {
      "files": ["worker/room.ts"],
      "rules": {
        "max-lines": "allow",
        "complexity": "allow"
      }
    },
    {
      "files": ["worker/index.ts"],
      "rules": {
        "complexity": "allow"
      }
    }
  ]
}
