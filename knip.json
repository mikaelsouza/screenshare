{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "electron/preload.cts",
    "electron/main.ts",
    "test/e2e/*.test.ts"
  ],
  "project": [
    "src/**/*.ts",
    "shared/**/*.ts",
    "worker/**/*.ts",
    "electron/**/*.{ts,cts}",
    "scripts/**/*.ts",
    "test/**/*.ts"
  ],
  "vitest": {
    "config": [
      "vitest.config.ts",
      "vitest.workers.config.ts"
    ]
  }
}
