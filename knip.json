{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "electron/preload.cjs"
  ],
  "project": [
    "src/**/*.{js,ts}",
    "shared/**/*.{js,ts}",
    "worker/**/*.{js,ts}",
    "electron/**/*.{js,cjs}",
    "scripts/**/*.{js,mjs}",
    "test/**/*.{js,ts,mjs}"
  ],
  "rules": {
    "cycles": "error"
  },
  "vitest": {
    "config": [
      "vitest.config.ts",
      "vitest.workers.config.ts"
    ]
  }
}
