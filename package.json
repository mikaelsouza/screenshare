{
  "name": "screenshare",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "check": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.worker.json",
    "preview": "npm run build && wrangler dev",
    "deploy": "npm run build && wrangler deploy",
    "postinstall": "./scripts/patch-workerd.sh || true",
    "test:unit": "vitest run --config vitest.config.ts",
    "test:worker": "vitest run --config vitest.workers.config.ts",
    "test:e2e": "npm run build && node --test --test-concurrency=1 test/e2e/*.test.mjs",
    "test": "npm run check && npm run test:unit && npm run test:worker",
    "test:all": "npm run test && npm run test:e2e"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.23.0",
    "@cloudflare/workers-types": "^5",
    "@vitest/coverage-v8": "^4.1.12",
    "playwright-core": "^1",
    "typescript": "^7.0",
    "vite": "^8",
    "vitest": "^4.1.12",
    "wrangler": "^4.149.0"
  },
  "overrides": {
    "sharp": "^0.35.4"
  }
}
