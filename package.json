{
  "name": "screenshare",
  "version": "1.0.0",
  "description": "Screenshare desktop application",
  "author": "Screenshare Team",
  "private": true,
  "type": "module",
  "main": "electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "check": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.worker.json",
    "preview": "npm run build && wrangler dev",
    "deploy": "npm run build && wrangler deploy",
    "postinstall": "node -e \"if(process.platform!=='win32')try{require('child_process').execSync('./scripts/patch-workerd.sh')}catch(e){}\"",
    "test:unit": "vitest run test/unit --config vitest.config.ts",
    "test:worker": "vitest run --config vitest.workers.config.ts",
    "test:formal": "vitest run test/formal --config vitest.config.ts --passWithNoTests",
    "test:fuzz": "vitest run test/fuzz --config vitest.config.ts --passWithNoTests",
    "test:mutant": "node scripts/run-mutation.mjs",
    "test:mutant:stryker": "stryker run",
    "test:e2e": "npm run build && node --test --test-concurrency=1 test/e2e/*.test.mjs",
    "test": "npm run check && npm run test:unit && npm run test:worker",
    "test:all": "npm run test && npm run test:formal && npm run test:fuzz && npm run test:e2e",
    "electron:dev": "concurrently -k -s first -n vite,electron \"cross-env ELECTRON_SERVER_PORT=5174 vite --port 5173 --strictPort\" \"wait-on -t 30000 tcp:localhost:5173 && cross-env ELECTRON_DEV=1 ELECTRON_SERVER_PORT=5174 VITE_DEV_SERVER_URL=http://localhost:5173 electron .\"",
    "electron:start": "npm run build && electron .",
    "electron:pack": "npm run build && electron-builder --dir",
    "electron:build": "npm run build && electron-builder --win",
    "electron:smoke": "npm run build && node scripts/smoke-test.mjs"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.23.0",
    "@cloudflare/workers-types": "^5",
    "@stryker-mutator/core": "^10.1.1",
    "@stryker-mutator/vitest-runner": "^10.1.1",
    "@vitest/coverage-v8": "^4.1.12",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "electron": "^35.0.0",
    "electron-builder": "^25.1.8",
    "fast-check": "^4.10.2",
    "playwright-core": "^1",
    "typescript": "^7.0",
    "vite": "^8",
    "vitest": "^4.1.12",
    "wait-on": "^8.0.2",
    "wrangler": "^4.149.0"
  },
  "overrides": {
    "sharp": "^0.35.4"
  }
}
