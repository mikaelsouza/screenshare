{
  "name": "screenshare",
  "main": "worker/index.ts",
  "compatibility_date": "2026-08-22",
  "compatibility_flags": ["nodejs_compat"],

  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // "none", NOT "single-page-application": SPA fallback rewrites every unmatched
    // path to index.html, which would swallow /ws/* and /api/* before they ever
    // reach the Worker. With "none" they fall through to the Worker as intended.
    "not_found_handling": "none",
    // Every request, not just /ws and /api. With a path list, anything that matches an
    // asset is served straight off the edge and the Worker never runs — so the
    // security headers applied in applySecurityHeaders() reached /api/room and nothing
    // else. The document itself, the one thing that needs a CSP and X-Frame-Options,
    // shipped bare. Routing everything through the Worker keeps one source of truth
    // for those headers; the cost is a Worker invocation per asset, which is nothing
    // against 100k/day for a room of friends.
    "run_worker_first": true
  },

  "durable_objects": {
    "bindings": [{ "name": "ROOMS", "class_name": "RoomDO" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["RoomDO"] }],

  // Per-client limits shared across isolates (worker/index.ts keys them by IPv4
  // address or IPv6 /64). Same budgets as the in-memory limiters beside them, which
  // only see one isolate each. namespace_id just has to be unique in the account.
  "ratelimits": [
    { "name": "WS_LIMITER", "namespace_id": "3101", "simple": { "limit": 60, "period": 60 } },
    { "name": "ROOM_LIMITER", "namespace_id": "3102", "simple": { "limit": 20, "period": 60 } },
    // TURN credentials minted per client (worker/room.ts). Past it, joins still
    // succeed with STUN only.
    { "name": "TURN_LIMITER", "namespace_id": "3103", "simple": { "limit": 20, "period": 60 } }
  ]

  // Attach the custom domain once DNS is ready:
  // "routes": [{ "pattern": "screenshare.webmikas.<tld>", "custom_domain": true }]
}
